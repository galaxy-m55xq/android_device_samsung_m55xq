# Allow vendor_shsusrd to access verinfo sysfs nodes and rmnet parameters
# Fixes common denials seen on Samsung devices

allow vendor_shsusrd sysfs:file { read open getattr };
allow vendor_shsusrd sysfs:dir search;

allow vendor_shsusrd sysfs_verinfo:file r_file_perms;
allow vendor_shsusrd sysfs_verinfo:dir search;

allow vendor_shsusrd vendor_sysfs_rmnet:dir search;
allow vendor_shsusrd vendor_sysfs_rmnet:file r_file_perms;
